# MySQL
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=reporting_db
MYSQL_USER=report_user
MYSQL_PASSWORD=your_password

# Solr
SOLR_HOST=solr
SOLR_PORT=8983
SOLR_COLLECTION=report_data

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=report_data_topic
KAFKA_DLQ_TOPIC=report_data_dlq
KAFKA_CONSUMER_GROUP=report-consumer-group

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRY=3600

# Frontend
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:3001

# Realtime
REALTIME_BROADCAST_URL=http://realtime-server:3001/broadcast
REALTIME_PORT=3001

# Scheduled reports / email
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=reports@example.local
SCHEDULE_WORKER_INTERVAL_SECONDS=60
SCHEDULE_ATTACHMENT_MAX_BYTES=10485760
